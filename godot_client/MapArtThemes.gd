class_name MapArtThemes
extends RefCounted
## SINH TỰ ĐỘNG (build.py từ themes.py) - muốn đổi theme: sửa themes.py rồi chạy lại, hoặc sửa tay cho gọn.
## floor/wall/out: danh sách key (lặp key = tăng trọng số). trees/props: nhóm {w: trọng số, f: danh sách key}.
static func get_def(name: String) -> Dictionary:
	match name:
		"mine":
			return {"floor": ["cf_1", "cf_9", "cf_10", "cf_4"], "floor_tint": Color(0.95, 0.92, 0.9), "wall": ["cf_2"], "wall_tint": Color(0.82, 0.78, 0.84), "out": ["cw_1"], "out_tint": Color(0.4, 0.45, 0.55), "out_pulse": false, "trees": [], "tree_density": 0.0, "props": [{"w": 3, "f": ["cp_19", "cp_31"]}, {"w": 2, "f": ["or_4", "or_5", "or_6", "or_7", "or_8", "or_9"]}, {"w": 1, "f": ["cp_3", "cp_4", "cp_5", "cp_6", "cp_7", "cp_8"]}, {"w": 1, "f": ["cp_27", "cp_15", "cp_18", "cp_26"]}, {"w": 2, "f": ["cm_1", "cm_2", "cm_3", "cm_4", "cm_5", "cm_6", "cm_7"]}], "prop_density": 0.07, "prop_tint": Color(0.9, 0.88, 0.9), "floor_wash": Color(0.0, 0.0, 0.0, 0.0)}
		"hell":
			return {"floor": ["cf_1", "cf_9", "cf_10", "cf_4"], "floor_tint": Color(0.92, 0.6, 0.5), "wall": ["cf_2"], "wall_tint": Color(0.75, 0.48, 0.48), "out": ["cl_1", "cl_3"], "out_tint": Color(1.0, 1.0, 1.0), "out_pulse": true, "trees": [], "tree_density": 0.0, "props": [{"w": 4, "f": ["cm_1", "cm_2", "cm_3", "cm_4", "cm_5", "cm_6", "cm_7"]}, {"w": 1, "f": ["cm_8", "cm_10"]}, {"w": 1, "f": ["cp_14", "cp_15"]}, {"w": 2, "f": ["cp_26"]}, {"w": 2, "f": ["or_4", "or_5", "or_6", "or_7", "or_8", "or_9"]}], "prop_density": 0.07, "prop_tint": Color(1.0, 0.78, 0.72), "floor_wash": Color(0.0, 0.0, 0.0, 0.0)}
		"desert":
			return {"floor": ["bt_1", "bt_1", "bt_1", "bt_2"], "floor_tint": Color(1.0, 0.92, 0.75), "wall": ["bt_7"], "wall_tint": Color(1.0, 0.9, 0.7), "out": ["bt_2"], "out_tint": Color(0.78, 0.66, 0.46), "out_pulse": false, "trees": [{"w": 1, "f": ["bb_12", "bb_13"]}], "tree_density": 0.012, "props": [{"w": 4, "f": ["bb_8", "bb_9", "bb_10"]}, {"w": 3, "f": ["bb_5", "bb_6"]}, {"w": 3, "f": ["br_4", "br_5", "br_6", "br_7", "br_8"]}, {"w": 1, "f": ["br_1", "br_2", "br_3"]}, {"w": 1, "f": ["bd_40", "bd_41"]}, {"w": 1, "f": ["bd_29", "bd_30", "bd_31", "bd_32", "bd_38"]}], "prop_density": 0.05, "prop_tint": Color(1.0, 0.95, 0.8), "floor_wash": Color(0.0, 0.0, 0.0, 0.0)}
		"sky":
			return {"floor": ["og_2", "og_2", "og_4", "og_4"], "floor_tint": Color(0.95, 0.97, 1.0), "floor_wash": Color(0.86, 0.93, 1.0, 0.62), "wall": ["bt_7"], "wall_tint": Color(0.95, 0.97, 1.0), "out": ["ow_1"], "out_tint": Color(0.7, 0.88, 1.0), "out_pulse": true, "trees": [], "tree_density": 0.0, "props": [{"w": 2, "f": ["ob_11"]}, {"w": 3, "f": ["ob_8", "ob_9", "ob_10"]}, {"w": 2, "f": ["or_6", "or_7", "or_8", "or_9"]}], "prop_density": 0.04, "prop_tint": Color(0.95, 0.98, 1.0)}
	return {"floor": ["og_2", "og_2", "og_4", "og_4"], "floor_tint": Color(0.9, 1.0, 0.8), "wall": ["bt_7"], "wall_tint": Color(0.92, 0.92, 0.86), "out": ["ow_1"], "out_tint": Color(0.6, 0.85, 1.0), "out_pulse": true, "trees": [{"w": 3, "f": ["tr_1", "tr_2", "tr_6", "tr_7", "tr_8"]}, {"w": 2, "f": ["tr_3", "tr_4"]}, {"w": 1, "f": ["tr_5"]}, {"w": 3, "f": ["tr_9", "tr_10", "tr_11"]}], "tree_density": 0.035, "props": [{"w": 4, "f": ["ob_1", "ob_2", "ob_3", "ob_4", "ob_5", "ob_6", "ob_7"]}, {"w": 3, "f": ["ob_8", "ob_9", "ob_10"]}, {"w": 2, "f": ["ob_11"]}, {"w": 3, "f": ["or_4", "or_5", "or_6", "or_7", "or_8", "or_9"]}, {"w": 1, "f": ["or_1", "or_2", "or_3"]}, {"w": 1, "f": ["op_10", "op_11", "op_12"]}], "prop_density": 0.06, "prop_tint": Color(0.95, 1.0, 0.9), "floor_wash": Color(0.0, 0.0, 0.0, 0.0)}
